# Copy this file to .env and fill in the values locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cjc_agent

# P2-05 controlled knowledge rollout.  Default is fail-closed: the existing
# path remains active.  `shadow` records a thread-local comparison; only
# `read_only_active` may show an approved read-only candidate.
CJC_READ_ONLY_ROLLOUT_MODE=off
CJC_READ_ONLY_ROLLOUT_CAPABILITIES=controlled_knowledge

# Optional local RAG tuning. Leave blank to use code defaults.
# RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# RAG_CANDIDATE_LIMIT=4
# DEEPSEEK_MAX_TOKENS=450
